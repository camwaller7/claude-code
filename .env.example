# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude API for categorization + draft replies) ---
ANTHROPIC_API_KEY=

# --- Meta: Facebook (via the Facebook app credentials) ---
# Create app at developers.facebook.com
META_APP_ID=
META_APP_SECRET=
# Random string used to verify webhook subscriptions from Meta
META_WEBHOOK_VERIFY_TOKEN=
# Tokens stored in platform_connections after OAuth — not needed here

# --- Instagram (standalone Instagram API with Business Login — separate ---
# --- credentials from the Meta/Facebook app above, per Meta's "Instagram ---
# --- API" use case in the developer dashboard) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Threads (its own use case in the Meta developer dashboard — separate ---
# --- app credentials from both the Facebook app and the Instagram app above) ---
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- X (Twitter) OAuth 2.0 PKCE (for DM sync, tweet posting, token refresh) ---
# Create app at developer.twitter.com → OAuth 2.0 Client ID + Secret
X_CLIENT_ID=
X_CLIENT_SECRET=
# Legacy v1.1 keys (only needed if using v1.1 endpoints — not currently used)
# X_API_KEY=
# X_API_SECRET=

# --- TikTok (via third-party scheduling provider, not TikTok's own API directly) ---
TIKTOK_PROVIDER_API_KEY=

# --- Gmail (Google Cloud Console → OAuth 2.0 credentials) ---
# Enable Gmail API in the Cloud project, create OAuth 2.0 Client ID (Web application)
# Authorised redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Inngest (background/scheduled jobs) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- App ---
# Used by Inngest sync functions to self-call /api/gmail/sync and /api/x/sync
# Set to https://your-app.vercel.app in production; http://localhost:3000 locally
NEXT_PUBLIC_APP_URL=

# --- Additional LLM providers (optional — only needed if using that provider) ---
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# --- Internal ---
# Shared secret for internal background jobs (Inngest -> sync API routes).
# Set to any long random string; must match on both ends (same deployment).
INTERNAL_API_SECRET=

# 32-byte key (base64-encoded) used to encrypt platform_connections access/
# refresh tokens before storage — a leaked SUPABASE_SERVICE_ROLE_KEY alone
# can't decrypt them without this. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CRITICAL: back this up somewhere safe outside Railway. If it's lost, every
# stored token becomes permanently undecryptable and every platform needs
# reconnecting. Rotating it requires re-encrypting existing rows (or just
# reconnecting everything) — don't change it casually once accounts are live.
TOKEN_ENCRYPTION_KEY=

# --- Security (REQUIRED before connecting real accounts) ---
# This app is single-creator only. Supabase's RLS policies grant any signed-in
# user full access to every table, so OWNER_EMAIL is the real access boundary
# — every auth/API guard rejects any other email, even if someone else signs
# up. Set this to the creator's exact login email. May be a comma-separated
# allowlist (e.g. "creator@x.com,meta-reviewer@y.com") — used to grant a Meta
# App Review test account temporary access during review; remove it after.
OWNER_EMAIL=

# Set to "true" to enable verbose Meta webhook/reply diagnostic logging. These
# lines include Meta user data (message bodies, contact names, raw payloads),
# so leave UNSET in production for data-handling compliance; enable only while
# actively debugging.
META_DEBUG_LOGGING=

# Emergency kill switch. Set to "true" to immediately lock every page and API
# route behind a maintenance message — use if you suspect a breach or a
# critical bug and need to take the app offline without a deploy.
MAINTENANCE_MODE=false
