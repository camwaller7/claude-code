# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude API for categorization + draft replies) ---
ANTHROPIC_API_KEY=

# --- Meta (covers Instagram + Facebook + Threads via one app) ---
# Create app at developers.facebook.com, add Instagram, Messenger, Threads products
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Random string used to verify webhook subscriptions from Meta
META_WEBHOOK_VERIFY_TOKEN=
# Tokens stored in platform_connections after OAuth — not needed here

# --- X (Twitter) OAuth 2.0 PKCE (for DM sync, tweet posting, token refresh) ---
# Create app at developer.twitter.com → OAuth 2.0 Client ID + Secret
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
# Legacy v1.1 keys (only needed if using v1.1 endpoints — not currently used)
# X_API_KEY=
# X_API_SECRET=

# --- TikTok (via third-party scheduling provider, not TikTok's own API directly) ---
TIKTOK_PROVIDER_API_KEY=

# --- Gmail (Google Cloud Console → OAuth 2.0 credentials) ---
# Enable Gmail API in the Cloud project, create OAuth 2.0 Client ID (Web application)
# Authorised redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Inngest (background/scheduled jobs) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- App ---
# Used by Inngest sync functions to self-call /api/gmail/sync and /api/x/sync
# Set to https://your-app.vercel.app in production; http://localhost:3000 locally
NEXT_PUBLIC_APP_URL=
